# ── always ───────────────────────────────────────────────────────────────────────────────────────
# Public hostname that points at the server (A record). Caddy gets its certificate for this.
HUB_DOMAIN=play.example.com
# Image to run. Leave unset to build it from this repo (docker compose up -d --build).
#HUB_IMAGE=ghcr.io/OWNER/playhub-hub:latest

# ── where players' TURN relay comes from ─────────────────────────────────────────────────────────
# none        STUN only (works on a LAN and for most players; no relay for strict NATs)
# cloudflare  Cloudflare Realtime TURN (free 1 000 GB/month). The server only does signaling: no UDP
#             ports, no coturn. Good for a small server.
# coturn      your own coturn (docker compose --profile coturn up -d). Needs the UDP ports open
#             (3478, 5349, 49160-49200) and a `turn.` DNS record.
# static      fixed credentials from any provider (TURN_STATIC_JSON)
TURN_PROVIDER=none

# cloudflare: dashboard → Realtime → TURN → create a key. Keep the token secret.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Credential lifetime, seconds (cloudflare default 86400; coturn default 3600).
#TURN_TTL_SECONDS=

# coturn only:
#TURN_HOST=turn.example.com
#TURN_SECRET=            # openssl rand -hex 32
#EXTERNAL_IP=            # the server's public IPv4
#PRIVATE_IP=             # its private IP (ip -4 addr)

# static only: a JSON array of ICE servers
#TURN_STATIC_JSON=[{"urls":"turn:example:3478","username":"u","credential":"c"}]
