{
  "name": "@playhub/protocol",
  "description": "Wire protocol for playhub: zod schemas shared by the hub and game clients.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "leonRandip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonRandip/playhub.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/leonRandip/playhub#readme",
  "bugs": "https://github.com/leonRandip/playhub/issues",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "multiplayer",
    "webrtc",
    "protocol",
    "zod",
    "game"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
