{
  "name": "@playhub/client",
  "description": "Multiplayer SDK for vibe-coded web games: rooms, room codes, ready-up, synchronized start and WebRTC peer-to-peer links.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Maria Randip Leon K S",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonRandip/playhub-sdk.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/leonRandip/playhub-sdk#readme",
  "bugs": "https://github.com/leonRandip/playhub-sdk/issues",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "multiplayer",
    "webrtc",
    "p2p",
    "peer-to-peer",
    "game",
    "gamedev",
    "lobby",
    "signaling",
    "browser-games",
    "sdk",
    "vibe-coding",
    "vibe-coded",
    "multiplayer-sdk",
    "web-games",
    "html5-games",
    "realtime",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@playhub/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
