{
  "name": "playhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @playhub/hub dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "hub-load": "pnpm --filter @playhub/hub load"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "description": "The multiplayer SDK for your vibe-coded web games: lobbies, room codes, WebRTC peer-to-peer and TURN, self-hosted or on Cloudflare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonRandip/playhub-sdk.git"
  }
}
